{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  // @earendil-works/* paths and the node types are injected at typecheck
  // time by tools/typecheck.sh (generated tsconfig.deps.json); runtime
  // resolution for tests comes from tests/deps.mjs. pi itself resolves
  // these imports when the extension runs.
  "include": ["*.ts"]
}
