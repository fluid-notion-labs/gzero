#!/bin/sh
# Dev gzero-mcp: execs this repo's locally built gzero-mcp instead of the
# installed ~/.local/share/gzero/bin one, so dev sessions ("moving fast
# and breaking stuff") always talk to the current source.
#
# Wired up via .pi/mcp.json ("context" -> this shim). The plugin prefers
# <cwd>/.pi/dev-gzero-mcp for its own calls too.
#
# Prefers the release build when it is current: MCP startup is on pi's
# critical path and a debug build costs ~5s extra (automerge load + seed
# reconcile are ~10x slower unoptimized). Falls back to debug when the
# release binary is missing or older than any file under src/, so dev
# sessions still never talk to stale code.
bin_release="$PWD/target/release/gzero-mcp"
bin_debug="$PWD/target/debug/gzero-mcp"
if [ -x "$bin_release" ] && [ -z "$(find "$PWD/src" -type f -newer "$bin_release" -print -quit 2>/dev/null)" ]; then
    exec "$bin_release" "$@"
fi
if [ -n "$CX_TRACE" ]; then
    echo "dev-gzero-mcp: release stale or missing; using debug (slow startup — run: cargo build --release)" >&2
fi
exec "$bin_debug" "$@"
