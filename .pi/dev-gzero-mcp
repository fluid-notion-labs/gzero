#!/bin/sh
# Dev gzero-mcp: execs this repo's locally built gzero-mcp instead of the
# installed ~/.cargo/bin one, so dev sessions ("moving fast and breaking
# stuff") always talk to the current source.
#
# Wired up via .pi/mcp.json ("context" -> this shim). The plugin prefers
# <cwd>/.pi/dev-gzero-mcp for its own calls too.
exec -- "$PWD/target/debug/gzero-mcp" "$@"
